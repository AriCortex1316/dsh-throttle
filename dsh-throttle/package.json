{
  "name": "dsh-throttle",
  "version": "2.0.0",
  "private": true,
  "description": "Three-tier reasoning and tool-exploration throttling for DeepSeek Harness, with per-turn step and time checks and staged summaries for user feedback.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "state.js",
    "schemas.js",
    "lib/",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/throttle.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "meta": {
    "title": "Throttle",
    "description": "Three tiers control per-turn steps, elapsed time, and reasoning effort. A soft checkpoint at 75% observed usage prompts an early hand-back; exceeding a limit refuses further tools. Staged summaries help users review findings and guide the next step."
  }
}
